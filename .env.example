# Copy these into Vercel: Project -> Settings -> Environment Variables
# (for local testing with `vercel dev`, put them in a file named .env.local)

# Secret key from https://resend.com/api-keys  (never commit the real key)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered
ENQUIRY_TO_EMAIL=technologydirector@karnishgroup.com

# Sender address. Must be on a domain verified in Resend, e.g. karnishgroup.com
ENQUIRY_FROM_EMAIL=Karnish Website <enquiries@karnishgroup.com>
